# Application settings
APP_PORT=5000
NETWORK=base-sepolia
MAX_DEADLINE_SECONDS=60
DEBUG=false

# Dashboard API (x402-payment-link)
LINK_API_BASE=http://localhost:3000
LINK_API_KEY=
LINK_API_TIMEOUT=5

# Wallet address for receiving payments
ADDRESS=your_wallet_address_here

# CDP API Keys (required for production network)
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# Paywall branding
APP_NAME=x402-mvp
APP_LOGO=/static/secondstate.png
FACILITATOR_URL=https://x402f1.secondstate.io

# Email (SendGrid)
SENDGRID_API_KEY=
FROM_EMAIL=your_email@example.com
ORDER_CONFIRMATION_RECIPIENT=recipient@example.com
